[Unit]
Description=Discord Music Bot
After=network.target

[Service]
Type=simple
User=root
# Wymagane jest podanie właściwej ścieżki do plików, przykładowo:
WorkingDirectory=/opt/bot-muzyczny
ExecStart=/opt/bot-muzyczny/venv/bin/python main.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
